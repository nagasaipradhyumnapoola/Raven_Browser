{
  "name": "raven-browser-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Raven Browser (RavenBrowser.exe) + Raven Master Server (MasterServer.exe)",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "build:freellm": "node scripts/bundle-freellm.mjs",
    "test": "node scripts/build.mjs --tests && node --test --test-concurrency=1 \"build/tests/*.test.cjs\"",
    "start:master": "node scripts/build.mjs && electron build/master-server",
    "start:browser": "node scripts/build.mjs && electron build/raven-browser",
    "dist": "node scripts/dist.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/anton": "5.2.7",
    "@fontsource/jersey-10": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/permanent-marker": "5.2.7",
    "@fontsource/space-grotesk": "5.2.10",
    "ascii.rest": "0.4.0",
    "bonjour-service": "1.4.4",
    "highlight.js": "11.12.0",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "selfsigned": "5.5.0",
    "sharp": "0.35.3",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "^5.8.0"
  }
}
