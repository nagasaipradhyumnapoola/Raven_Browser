{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@raven/shared": [
        "packages/shared/src/index.ts"
      ],
      "@raven/security": [
        "packages/security/src/index.ts"
      ],
      "@raven/network-protocol": [
        "packages/network-protocol/src/index.ts"
      ],
      "@raven/local-memory": [
        "packages/local-memory/src/index.ts"
      ],
      "@raven/ui": [
        "packages/ui/src/index.tsx"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "apps/*/src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "apps/master-server/src/freellm-host",
    "vendor",
    "build",
    "node_modules"
  ]
}